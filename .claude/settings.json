{
  "permissions": {
    "deny": [
      "Bash(*drop_table*)",
      "Bash(*fractalaw embed*)",
      "Bash(*db.drop_table*)",
      "Bash(*create_table_from_batches*legislation_text*)",
      "Bash(*create_table_from_parquet*legislation_text*)",
      "Bash(*TRUNCATE*legislation*)",
      "Bash(*DROP TABLE*legislation*)",
      "Bash(*rm*fractalaw.duckdb*)",
      "Bash(*taxa enrich --force)",
      "Bash(*rm*legislation_text.lance*)",
      "Bash(*cargo sweep --time 0*)",
      "Bash(*cargo sweep --time 1*)",
      "Bash(*rm -rf*target*)",
      "Bash(*cargo clean*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR\"/.claude/skills/cross-instrument-holders/scripts/check_due.py --hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
